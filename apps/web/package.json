{
  "name": "@doc2audio/web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:runtime && vite --host 127.0.0.1",
    "build": "npm run prepare:runtime && tsc -b && vite build && node ../../scripts/build-web-cache.mjs",
    "check": "tsc --noEmit",
    "format:check": "prettier --check src vite.config.ts",
    "format": "prettier --write src vite.config.ts",
    "prepare:runtime": "node ../../scripts/prepare-web-runtime.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run src"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "cfb": "1.2.2",
    "idb": "8.0.3",
    "mammoth": "1.12.3",
    "onnxruntime-web": "1.29.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "soundtouchjs": "0.3.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "28.1.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "5.0.0"
  }
}
