# Allow only the browser application's build inputs. Local models, documents,
# jobs, outputs, credentials, Git history and installed dependencies stay out.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!apps/
apps/**
!apps/web/
apps/web/**
!apps/web/package.json
!apps/web/index.html
!apps/web/tsconfig.json
!apps/web/vite.config.ts
!apps/web/src/
!apps/web/src/**
!apps/web/public/
apps/web/public/**
!apps/web/public/*.png
!apps/web/public/favicon.ico
!apps/web/public/site.webmanifest
!apps/web/public/brand/
!apps/web/public/notices/
apps/web/public/notices/**
!apps/web/public/notices/ONNX-LICENSE.txt
!apps/web/public/voice-samples/
apps/web/public/voice-samples/**
!apps/web/public/voice-samples/qwen3-1.7b/
apps/web/public/voice-samples/qwen3-1.7b/**
!apps/web/public/voice-samples/qwen3-1.7b/*.mp3
!apps/web/public/voice-samples/qwen3-0.6b/
apps/web/public/voice-samples/qwen3-0.6b/**
!apps/web/public/voice-samples/qwen3-0.6b/*.mp3
!apps/web/public/voice-samples/supertonic-3/
apps/web/public/voice-samples/supertonic-3/**
!apps/web/public/voice-samples/supertonic-3/*.mp3
!apps/web/public/voice-samples/manifest.json
!scripts/
scripts/**
!scripts/prepare-web-runtime.mjs
!scripts/build-web-cache.mjs
!docker/
docker/**
!docker/nginx.conf
apps/web/dist/**
apps/web/public/runtime/**
**/.git/**
**/.venv/**
**/.models/**
**/.doc2audio/**
**/input/**
**/output/**
**/.env*
**/.DS_Store
**/node_modules/**
**/*.tsbuildinfo
